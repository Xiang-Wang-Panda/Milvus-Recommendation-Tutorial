# ---- 虚拟环境（1.4G，torch 占了大半）----
.venv/
venv/
env/

# ---- Milvus Lite 的本地库 ----
# milvus.db 在 milvus-lite 3.x 下是个目录（parquet 数据 + 索引），跑一次全量 45M。
# 纯派生数据：删掉重跑 seed.py 就能一模一样地重建。
*.db
*.db/
# embedding 指纹旁路文件，跟着库走
*.db.embedding

# ---- 数据集：下载的和生成的，都是派生物 ----
# 前缀 **/ 是必须的：带斜杠的模式会锚定到本文件所在目录，不加就只匹配仓库根下的 data/
# MovieLens-1M 原始数据 24M，load_movielens.py 会重新下
**/data/ml-1m/
# products.csv / users.csv 由 load_movielens.py 生成
**/data/*.csv

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- 日志和临时产物 ----
*.log

# ---- Claude Code 的本机配置（记的是这台机器上的授权，不该共享）----
.claude/settings.local.json

# ---- 编辑器 / 系统 ----
.DS_Store
.idea/
.vscode/
*.swp
